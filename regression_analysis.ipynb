   "source": [
    "## Step 5: Building the OLS Regression Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_text": [
      "Data prepared for regression:\n",
      "Independent Variable: Radio\n",
      "Dependent Variable: Sales\n",
      "Sample Size: 16\n"
     ]
    }
   ],
   "source": [
    "X = df_clean['Radio']\n",
    "y = df_clean['Sales']\n",
    "X = sm.add_constant(X)\n",
    "\n",
    "print('Data prepared for regression:')\n",
    "print('Independent Variable: Radio')\n",
    "print('Dependent Variable: Sales')\n",
    "print(f'Sample Size: {len(y)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_text": [
      "OLS Regression Results:\n",
      "R-squared: 0.8951\n",
      "Adj. R-squared: 0.8871\n",
      "F-statistic: 119.7995\n",
      "Prob (F-statistic): 1.13e-08\n",
      "\n",
      "Coefficients:\n",
      "                 coef    std err          t      P>|t|\n",
      "const          21.4931      7.9287      2.710      0.016\n",
      "Radio           8.5564      0.7811     10.955      0.000\n"
     ]
    }
   ],
   "source": [
    "model = sm.OLS(y, X).fit()\n",
    "\n",
    "print('OLS Regression Results:')\n",
    "print(f'R-squared: {model.rsquared:.4f}')\n",
    "print(f'Adj. R-squared: {model.rsquared_adj:.4f}')\n",
    "print(f'F-statistic: {model.fvalue:.4f}')\n",
    "print(f'Prob (F-statistic): {model.f_pvalue:.2e}')\n",
    "print('\\nCoefficients:')\n",
    "print(model.summary().tables[1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_text": [
      "KEY MODEL PARAMETERS\n",
      "====================\n",
      "Regression Equation: Sales = 21.4931 + 8.5564 * Radio\n",
      "\n",
      "Model Fit Metrics:\n",
      "R-squared: 0.8951 (89.51%)\n",
      "Adjusted R-squared: 0.8871\n",
      "F-statistic: 119.7995\n",
      "Prob (F-statistic): 1.13e-08\n",
      "\n",
      "Radio Coefficient Details:\n",
      "Estimate: 8.556398\n",
      "Std Error: 0.781077\n",
      "t-statistic: 10.9547\n",
      "p-value: 2.75e-08\n",
      "95% CI: [6.8804, 10.2324]\n"
     ]
    }
   ],
   "source": [
    "intercept = model.params['const']\n",
    "slope = model.params['Radio']\n",
    "r_squared = model.rsquared\n",
    "adj_r_squared = model.rsquared_adj\n",
    "f_statistic = model.fvalue\n",
    "f_pvalue = model.f_pvalue\n",
    "residuals = model.resid\n",
    "fitted_values = model.fittedvalues\n",
    "\n",
    "radio_coef = model.params['Radio']\n",
    "radio_se = model.bse['Radio']\n",
    "radio_tstat = model.tvalues['Radio']\n",
    "radio_pvalue = model.pvalues['Radio']\n",
    "radio_ci = model.conf_int().loc['Radio']\n",
    "\n",
    "print('KEY MODEL PARAMETERS')\n",
    "print('='*20)\n",
    "print(f'Regression Equation: Sales = {intercept:.4f} + {slope:.4f} * Radio')\n",
    "print(f'\\nModel Fit Metrics:')\n",
    "print(f'R-squared: {r_squared:.4f} ({r_squared*100:.2f}%)')\n",
    "print(f'Adjusted R-squared: {adj_r_squared:.4f}')\n",
    "print(f'F-statistic: {f_statistic:.4f}')\n",
    "print(f'Prob (F-statistic): {f_pvalue:.2e}')\n",
    "print(f'\\nRadio Coefficient Details:')\n",
    "print(f'Estimate: {radio_coef:.6f}')\n",
    "print(f'Std Error: {radio_se:.6f}')\n",
    "print(f't-statistic: {radio_tstat:.4f}')\n",
    "print(f'p-value: {radio_pvalue:.2e}')\n",
    "print(f'95% CI: [{radio_ci[0]:.4f}, {radio_ci[1]:.4f}]')"
   ]
