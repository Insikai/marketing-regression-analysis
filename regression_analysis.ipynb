    }
   ],
   "source": [
    "shapiro_stat, shapiro_p = stats.shapiro(residuals)\n",
    "bp_stat, bp_p, _, _ = het_breuschpagan(residuals, X)\n",
    "dw_stat = durbin_watson(residuals)\n",
    "\n",
    "print('REGRESSION ASSUMPTIONS VALIDATION')\n",
    "print('='*35)\n",
    "print('\\n1. LINEARITY TEST')\n",
    "print('Assessed via: Residuals vs Fitted Values Plot')\n",
    "print('Visual Assessment: Linear relationship appears adequate')\n",
    "\n",
    "print('\\n2. NORMALITY TEST (Shapiro-Wilk)')\n",
    "print(f'Test Statistic: {shapiro_stat:.6f}')\n",
    "print(f'P-value: {shapiro_p:.6f}')\n",
    "print(f'Result: PASS - Residuals are normally distributed (p > 0.05)' if shapiro_p > 0.05 else 'Result: FAIL')\n",
    "\n",
    "print('\\n3. HOMOSCEDASTICITY TEST (Breusch-Pagan)')\n",
    "print(f'Test Statistic: {bp_stat:.6f}')\n",
    "print(f'P-value: {bp_p:.6f}')\n",
    "print(f'Result: PASS - Constant variance assumption holds (p > 0.05)' if bp_p > 0.05 else 'Result: FAIL')\n",
    "\n",
    "print('\\n4. INDEPENDENCE TEST (Durbin-Watson)')\n",
    "print(f'Test Statistic: {dw_stat:.6f}')\n",
    "print(f'Result: PASS - No significant autocorrelation detected (1.5 < DW < 2.5)' if 1.5 < dw_stat < 2.5 else 'Result: WARNING')"
   ]
  },
  {
   "cell_type": "markdown",
