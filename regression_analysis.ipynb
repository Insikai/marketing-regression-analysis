    "## Step 6: Diagnostic Plots & Assumption Validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_text": [
      "Diagnostic plots created!\n"
